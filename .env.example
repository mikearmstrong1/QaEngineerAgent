# Local development credentials only. Never commit a real .env file.
POSTGRES_PASSWORD=quality-local-only
MINIO_ROOT_USER=quality-local
MINIO_ROOT_PASSWORD=quality-local-only

# Optional live planner. Keep Stub for demos; supply a supported model ID and API key to enable.
QUALITY_PLANNING_MODE=Stub
QUALITY_PLANNING_MODEL=
OPENAI_API_KEY=

# Semicolon-separated exact target origins; empty denies all execution.
QUALITY_EXECUTION_ALLOWED_ORIGINS=

# Enable after explicitly initializing the dedicated artifact bucket.
QUALITY_ARTIFACTS_MODE=Local
QUALITY_ARTIFACTS_BUCKET=quality-artifacts
QUALITY_ARTIFACTS_RETENTION_DAYS=30

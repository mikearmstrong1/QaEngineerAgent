# Local development credentials only. Never commit a real .env file.
# Set this to an immutable registry digest for deployment; the default uses quality-system:local.
QUALITY_IMAGE=quality-system:local
POSTGRES_PASSWORD=quality-local-only
MINIO_ROOT_USER=quality-local
MINIO_ROOT_PASSWORD=quality-local-only

# Optional live planner. Keep Stub for demos; supply a supported model ID and API key to enable.
QUALITY_PLANNING_MODE=Stub
QUALITY_PLANNING_MODEL=
OPENAI_API_KEY=
QUALITY_PLANNING_MAX_ATTEMPTS=3
QUALITY_PLANNING_ATTEMPT_TIMEOUT_SECONDS=20
QUALITY_PLANNING_TOTAL_TIMEOUT_SECONDS=75
QUALITY_PLANNING_MAX_OUTPUT_TOKENS=8192

# Semicolon-separated exact target origins; empty denies all execution.
QUALITY_EXECUTION_ALLOWED_ORIGINS=

# Repository that will receive reviewed regression patches. Use an absolute host path.
# The repository must contain the compatible Playwright execution support used by promoted tests.
QUALITY_REGRESSION_REPOSITORY=

# Enable after explicitly initializing the dedicated artifact bucket.
QUALITY_ARTIFACTS_MODE=Local
QUALITY_ARTIFACTS_BUCKET=quality-artifacts
QUALITY_ARTIFACTS_RETENTION_DAYS=30
QUALITY_ARTIFACTS_MAX_BYTES=134217728
QUALITY_ARTIFACTS_TIMEOUT_SECONDS=60
# For Azure Blob Storage, set mode to Azure and configure exactly one authentication path.
# Prefer the service URI with DefaultAzureCredential in hosted environments.
AZURE_STORAGE_CONNECTION_STRING=
QUALITY_ARTIFACTS_AZURE_SERVICE_URI=
QUALITY_ARTIFACTS_AZURE_CONTAINER=quality-artifacts

# Optional read-only Jira/Coda requirement ingestion.
QUALITY_REQUIREMENTS_MODE=Stub
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_ACCEPTANCE_FIELD=
CODA_TOKEN=
CODA_TITLE_COLUMN=
CODA_DESCRIPTION_COLUMN=
CODA_ACCEPTANCE_COLUMN=

# Explicit local demo mode. For shared environments set false and supply a random key.
# The Command Center at http://127.0.0.1:5081 uses this key only on its server side.
QUALITY_API_ALLOW_ANONYMOUS=true
QUALITY_API_KEY=

# Renew active job ownership; interval plus timeout must be shorter than duration.
QUALITY_LEASE_DURATION_SECONDS=300
QUALITY_LEASE_RENEWAL_INTERVAL_SECONDS=60
QUALITY_LEASE_RENEWAL_TIMEOUT_SECONDS=15
QUALITY_LEASE_CANCELLATION_POLL_INTERVAL_SECONDS=1

# Durable limits are captured for each new job. Existing jobs retain their original policy.
QUALITY_RETRY_MAX_WORKER_ATTEMPTS=5
QUALITY_RETRY_MAX_NORMALIZATION_ATTEMPTS=3
QUALITY_RETRY_MAX_DURATION_SECONDS=900
QUALITY_RETRY_INITIAL_DELAY_MILLISECONDS=250
QUALITY_RETRY_MAX_DELAY_MILLISECONDS=5000

# Optional standalone worker scrape listener; API metrics use /metrics on its existing port.
# For Compose, http://0.0.0.0:8081 is reachable only inside the Compose network.
QUALITY_METRICS_WORKER_URL=

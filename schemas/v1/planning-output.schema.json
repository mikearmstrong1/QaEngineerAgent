  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "testCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "category": {
            "type": "string",
            "enum": [
              "HappyPath",
              "Negative",
              "Boundary",
              "Regression",
              "Accessibility",
              "Security",
              "Other"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "acceptanceCriterionIds": {
            "type": "array",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.local/schemas/v1/test-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "testPlanId": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifactKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executorVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "manifestHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "testCaseIds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "storedArtifacts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "localKey": {
            "type": "string"
          },
          "objectKey": {
            "type": "string"
          },
          "bucket": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "storedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "checksumVerified": { "type": "boolean" },
              "redactionVerified": { "type": "boolean" },
              "verifiedAt": { "type": "string", "format": "date-time" }
            },
            "required": ["sourceSha256", "storedSha256", "checksumVerified", "redactionVerified", "verifiedAt"]
          }
        },
        "required": [
          "localKey",
          "objectKey",
          "bucket",
          "contentType",
          "length",
          "sha256"
        ]
      }
    },
    "artifactUploadStatus": {
      "enum": [
        null,
        "Uploading",
        "Uploaded",
        "Failed"
      ]
    },
    "failureClassification": {
      "enum": [
        null,
        "None",
        "NeedsReview",
        "ApplicationFailure",
        "TestFailure",
        "InfrastructureFailure",
        "Cancelled"
      ]
    },
    "failureReviewReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "testResults": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "testCaseId": { "type": "string" },
          "status": { "type": "string" },
          "classification": { "type": "string" },
          "durationMilliseconds": { "type": "integer", "minimum": 0 }
        },
        "required": ["testCaseId", "status", "classification", "durationMilliseconds"]
      }
    },
    "evidenceRequirements": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "requiredArtifactPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "retentionDays": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "required": ["requiredArtifactPatterns"]
    }
  },
  "required": [
    "id",
    "testPlanId",
    "status",
    "startedAt",
    "finishedAt",
    "artifactKeys",
    "executorVersion",
    "schemaVersion"
  ]
}

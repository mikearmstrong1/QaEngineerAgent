{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.local/schemas/v1/failure-analysis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "testRunId": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "evidenceArtifactKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requiresReview": {
      "type": "boolean"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "evidenceArtifacts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "localKey": {
            "type": "string"
          },
          "objectKey": {
            "type": "string"
          },
          "bucket": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "localKey",
          "objectKey",
          "bucket",
          "contentType",
          "length",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "id",
    "testRunId",
    "classification",
    "summary",
    "evidenceArtifactKeys",
    "confidence",
    "requiresReview",
    "schemaVersion"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.local/schemas/v1/requirement-reference.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source": {
      "enum": [
        "jira",
        "coda",
        "stub"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    }
  },
  "required": [
    "source",
    "id"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "jira"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$",
            "type": "string"
          }
        }
      }
    }
  ]
}

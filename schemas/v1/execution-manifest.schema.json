{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "testPlanId": {
      "type": "string",
      "minLength": 1
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "testCaseId": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "enum": [
                    "goto",
                    "click",
                    "fill",
                    "expectText",
                    "expectVisible",
                    "expectUrl"
                  ]
                },
                "selector": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 2000
                },
                "value": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 10000
                }
              },
              "required": [
                "action",
                "selector",
                "value"
              ]
            }
          }
        },
        "required": [
          "testCaseId",
          "steps"
        ]
      }
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "schemaVersion": {
      "const": "1.0"
    }
  },
  "required": [
    "testPlanId",
    "planHash",
    "target",
    "tests",
    "timeoutSeconds",
    "schemaVersion"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.local/schemas/v1/execution-manifest.schema.json"
}
